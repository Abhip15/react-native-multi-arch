    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "bun expo start --dev-client",
    "android": "bun expo run:android",
    "ios": "bun expo run:ios",
    "web": "bun expo start --web",
    "prebuild": "bun expo prebuild --clean",
    "lint": "bun expo lint",
    "typecheck": "bun tsc --noEmit",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "validate": "bun run lint && bun run typecheck",
    "doctor": "bun expo-doctor"
  },
  "private": true
